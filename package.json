{
  "name": "kesenmemento-v2",
  "version": "0.1.0",
  "private": true,
  "description": "KesenMemento v2: Kesennuma Living City. The real Kesennuma as an explorable anime-style 3D world in the browser, built from open data (GSI, OpenStreetMap, JMA).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ss251/kesenmemento-v2.git"
  },
  "homepage": "https://kesennuma-living-city-production.up.railway.app/",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "data": "bun run scripts/build-data.js",
    "live": "bun run scripts/live.js",
    "build": "bun run scripts/build-web.js",
    "serve": "bun run scripts/serve.js",
    "render": "bash blender/render.sh",
    "all": "bun test && bun run scripts/build-web.js",
    "stills": "bash tools/anime/gate.sh chrome bun run scripts/render/stills.js",
    "qa": "bash tools/anime/gate.sh chrome bun tools/anime/qa3.mjs --build 1 --phone 1",
    "build:railway": "bun run build && bun server/app/bundle.mjs",
    "start": "cd bundle && bun server.js"
  },
  "dependencies": {
    "3d-tiles-renderer": "0.5.3",
    "@mapbox/vector-tile": "2",
    "@sparkjsdev/spark": "2.2.0",
    "@takram/three-atmosphere": "0.19.1",
    "@takram/three-clouds": "0.7.6",
    "@takram/three-geospatial": "0.9.1",
    "astronomy-engine": "^2.1.19",
    "earcut": "3",
    "exifr": "^7.1.3",
    "pbf": "4",
    "postprocessing": "6.39.5",
    "sharp": "^0.35.5",
    "three": "0.186.1"
  },
  "engines": {
    "bun": "1.3.14"
  }
}
